---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="404 — Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <section class="max-w-xl text-center py-24 flex flex-col items-center">
    <p class="text-8xl sm:text-9xl font-display font-bold text-gradient mb-6 glitch-text active">404</p>
    <h1 class="text-2xl sm:text-3xl font-display font-bold text-[var(--color-text)] mb-3">Page not found</h1>
    <p class="text-[var(--color-text-muted)] mb-10 max-w-md">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a href="/" class="btn btn-primary">Go home</a>
  </section>
</BaseLayout>
