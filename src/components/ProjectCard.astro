---
interface Props {
  title: string
  description: string
  url: string
  tags: string[]
  repo?: string
  featured?: boolean
}

const { title, description, url, tags, repo, featured = false } = Astro.props
---

<div class="card-3d h-full flex flex-col gap-4 p-5 sm:p-6 group" data-tilt>
  <div class="card-glare"></div>

  <div class="flex items-start justify-between gap-3 relative z-10">
    <h3 class={`font-display font-semibold text-[var(--color-text)] ${featured ? 'text-xl sm:text-2xl' : 'text-lg'}`}>
      {title}
    </h3>
    {repo && (
      <a
        href={repo}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors relative z-20"
        aria-label={`View ${title} on GitHub`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    )}
  </div>

  <p class={`relative z-10 text-[var(--color-text-muted)] leading-relaxed ${featured ? 'text-base' : 'text-sm'}`}>
    {description}
  </p>

  <div class="flex flex-wrap gap-2 mt-auto relative z-10">
    {tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>

  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="relative z-20 text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] mt-1 inline-flex items-center gap-1 group-hover:gap-2 transition-all"
  >
    View Project <span>→</span>
  </a>
</div>
