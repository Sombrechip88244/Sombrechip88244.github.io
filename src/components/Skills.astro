---
const skills = {
  Languages: ['Python', 'Bash', 'HTML', 'CSS'],
  'Frameworks & Runtimes': [],
  'Tools & Infrastructure': ['Git', 'macOS', 'Docker', 'Linux'],
}
---

<div class="space-y-8">
  <p class="text-[var(--color-text-muted)] leading-relaxed text-lg">
    Software developer with a focus on open source and automation. Building tools and applications in my spare time.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
    {Object.entries(skills).map(([category, items]) => (
      <div class="reveal">
        <h3 class="text-xs font-semibold text-[var(--color-accent)] uppercase tracking-widest mb-4 font-display">{category}</h3>
        <ul class="space-y-2">
          {items.map((skill) => (
            <li class="text-sm text-[var(--color-text-muted)] flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] opacity-60"></span>
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
